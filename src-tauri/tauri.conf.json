{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "公文材料写作助手",
  "version": "0.1.0",
  "identifier": "com.local.gongwen-writer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build && npm run prepare:worker-runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "公文材料写作助手",
        "width": 1440,
        "height": 920,
        "minWidth": 1160,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../worker-runtime"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://example.com/gongwen-writer/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_TAURI_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
